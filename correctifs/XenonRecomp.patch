+// Guest time base (mftb): the Xbox 360 counts at 49.875 MHz, the ARM generic timer at its own
+// frequency (24 MHz on Apple silicon), so the value is converted. Games pace frames with it.
 inline uint64_t __rdtsc()
 {
-    uint64_t ret;
+    uint64_t ticks, frequency;
     asm volatile("mrs %0, cntvct_el0\n\t"
-                 : "=r"(ret)::"memory");
-    return ret;
+                 : "=r"(ticks)::"memory");
+    asm volatile("mrs %0, cntfrq_el0" : "=r"(frequency));
+    return uint64_t((unsigned __int128)ticks * 49875000u / frequency);
+}
+#elif defined(__x86_64__) || defined(_M_X64)
+// x64 (Windows, Linux): the processor counter (rdtsc) runs at the CPU frequency, the guest time base is derived
+// from the steady clock instead
+#include <chrono>
+inline uint64_t PPCGuestTimeBase()
+{
+    auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    return uint64_t((unsigned __int128)ns * 399 / 8000); // 49.875 MHz = 399 / 8 ticks per microsecond
 }
+#define __rdtsc() PPCGuestTimeBase()
 #elif !defined(__x86_64__) && !defined(_M_X64)
