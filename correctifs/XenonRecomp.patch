+inline simde__m128i simde_mm_cmpgt_epu32(simde__m128i a, simde__m128i b)
+{
+    simde__m128i c = simde_mm_set1_epi32(INT_MIN);
+    return simde_mm_cmpgt_epi32(simde_mm_xor_si128(a, c), simde_mm_xor_si128(b, c));
+}
+
+inline simde__m128i simde_mm_adds_epi32(simde__m128i a, simde__m128i b)
+{
+    simde__m128i sum = simde_mm_add_epi32(a, b);
+    // Overflow when both operands share a sign that differs from the sum
+    simde__m128i overflow = simde_mm_andnot_si128(simde_mm_xor_si128(a, b), simde_mm_xor_si128(a, sum));
+    simde__m128i saturated = simde_mm_xor_si128(simde_mm_srai_epi32(a, 31), simde_mm_set1_epi32(INT_MAX));
+    return simde_mm_blendv_epi8(sum, saturated, simde_mm_srai_epi32(overflow, 31));
+}
+
+inline simde__m128i simde_mm_packus_epu32(simde__m128i a, simde__m128i b)
+{
+    simde__m128i c = simde_mm_set1_epi32(0xFFFF);
+    return simde_mm_packus_epi32(simde_mm_min_epu32(a, c), simde_mm_min_epu32(b, c));
+}
