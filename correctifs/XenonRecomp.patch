+inline simde__m128i simde_mm_vctuxs(simde__m128 src1)
+{
+    // NaN and negative values become 0
+    simde__m128 src = simde_mm_max_ps(src1, simde_mm_setzero_ps());
+    simde__m128 bias = simde_mm_set1_ps(2147483648.0f);
+    simde__m128 high = simde_mm_cmpge_ps(src, bias);
+    simde__m128i dest = simde_mm_cvttps_epi32(simde_mm_sub_ps(src, simde_mm_and_ps(high, bias)));
+    dest = simde_mm_add_epi32(dest, simde_mm_and_si128(simde_mm_castps_si128(high), simde_mm_set1_epi32(INT_MIN)));
+    simde__m128 overflow = simde_mm_cmpge_ps(src, simde_mm_set1_ps(4294967296.0f));
+    return simde_mm_or_si128(dest, simde_mm_castps_si128(overflow));
+}
