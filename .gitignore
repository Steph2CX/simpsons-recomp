# Liste d'autorisation : tout est exclu sauf ce qui est explicitement repris ci-dessous.
# Jamais dans le depot : l'ISO, les donnees du jeu, le code genere a partir du jeu (simpsons/ppc*), les shaders
# traduits, les captures de test (sauf celles du README, dans captures/), les compilations, les reglages personnels (tvos/config.local).
/*
!/.gitignore
!/README.md
!/LICENSE
!/captures/
!/correctifs/

!/simpsons/
/simpsons/*
!/simpsons/runtime/
!/simpsons/lib/
!/simpsons/modifications/
/simpsons/modifications/textures/*.bin
!/simpsons/run.sh
!/simpsons/recomp/
/simpsons/recomp/*
!/simpsons/recomp/simpsons.toml
!/simpsons/recomp/simpsons_opt.toml
!/simpsons/recomp/simpsons_switch_tables.toml

!/tools/
/tools/__pycache__/
/tools/xexdump
/tools/test_helpers
/tools/test_manette/hid
/tools/test_manette/test_manette
/tools/test_manette/resultat.txt

!/portable/
/portable/*
!/portable/construire_dependances_mac.sh

!/linux/
/linux/*
!/linux/construire.sh

!/windows/
/windows/*
!/windows/creer_dossier_windows.sh
!/windows/LISEZMOI.txt
!/windows/mingw-x64.cmake
!/windows/mingw-x64-linux.cmake
!/windows/vulkan-1.def

!/tvos/
/tvos/*
!/tvos/creer_application_tvos.sh
!/tvos/construire_dependances_tvos.sh
!/tvos/config.exemple
!/tvos/sonde/
/tvos/sonde/*
!/tvos/sonde/main.m
!/tvos/sonde/project.yml
!/tvos/profil/
/tvos/profil/*
!/tvos/profil/main.m
!/tvos/profil/project.yml
!/tvos/profil/Simpsons.entitlements
!/tvos/icone/
/tvos/icone/*
!/tvos/icone/fabriquer_images.swift

.DS_Store
